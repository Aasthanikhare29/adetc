# Copy to .env.local and fill from your Supabase project (Settings → API).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server-only. Reserved for admin tasks that bypass RLS; not required today.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Service client for contact/subscribe API (lib/supabase.js)
SUPABASE_URL=https://YOUR_REF.supabase.co

# SMTP for contact/subscribe notification emails (optional; forms work without it)
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
MAIL_FROM="Ad Etc Studios <hello@adetcstudios.com>"
MAIL_TO=where-enquiries-should-go@adetcstudios.com
